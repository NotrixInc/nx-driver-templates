{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "base_url": { "type": "string", "description": "W2IO base URL, e.g. http://192.168.7.197" },
    "status_path": { "type": "string", "default": "/api/status", "description": "Path to read current device status" },
    "set_path": { "type": "string", "default": "/api/set", "description": "Path used to set writable values" },
    "username": { "type": "string", "description": "Optional API username" },
    "password": { "type": "string", "description": "Optional API password" },
    "auth_type": { "type": "string", "enum": ["none", "basic", "bearer"], "default": "none" },
    "bearer_token": { "type": "string", "description": "Bearer token when auth_type is bearer" },
    "poll_interval_ms": { "type": "integer", "default": 2000, "minimum": 250, "maximum": 60000 },
    "request_timeout_seconds": { "type": "integer", "default": 8, "minimum": 1, "maximum": 60 },
    "insecure_skip_tls_verify": { "type": "boolean", "default": false }
  },
  "required": ["base_url"]
}
